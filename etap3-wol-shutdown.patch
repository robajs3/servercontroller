+def act_wake():
+    if _last_state() == "ONLINE":
+        return _result("Serwer już działa.", False)
+    try:
+        actions.wake()
+    except Exception as e:
+        audit(f"wake FAIL: {type(e).__name__}")
+        return _result("Nie udało się wysłać pakietu WoL (usługa wol).", False)
