+
+@bp.app_template_filter("rate")
+def _rate(v):
+    v = v or 0
+    for u in ("B/s", "KB/s", "MB/s", "GB/s"):
+        if v < 1024:
+            return f"{v:.0f} {u}" if u == "B/s" else f"{v:.1f} {u}"
+        v /= 1024
+    return f"{v:.1f} TB/s"
+
