+    hours = RANGES.get(request.args.get("range", "1h"), 1)
+    raw = hours <= 24
+    step = max(int(hours * 3600 / 300), 10 if raw else 60)
+    rows = db.session.execute(text(M_RAW if raw else M_AGG),
+        {"s": step, "srv": srv, "since": now() - timedelta(hours=hours)}).all()
