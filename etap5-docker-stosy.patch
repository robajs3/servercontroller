+    {% if j.status == 'running' %}<span class="pill sm warn">trwa…</span>
+    {% elif j.rc == 0 %}<span class="pill sm ok">OK</span>
+    {% else %}<span class="pill sm bad">błąd ({{ j.rc }})</span>{% endif %}</p>
+  <pre class="log">{{ j.output }}</pre>
+</div>
