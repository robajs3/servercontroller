diff --git a/app/templates/camera.html b/app/templates/camera.html
new file mode 100644
index 0000000..d1e32dd
--- /dev/null
+++ b/app/templates/camera.html
@@ -0,0 +1,25 @@
+{% extends "base.html" %}{% block body %}
+<section class="card">
+  <div class="row"><h3>Kamera</h3>
+    <button id="go">▶ Na żywo</button><button class="ghost" id="stop">■ Stop</button>
+    <button class="ghost" id="snap">Odśwież zdjęcie</button>
+    <a class="tab" href="{{ url_for('cam.snapshot', download=1) }}">Pobierz zdjęcie</a></div>
+  <img id="cam" class="cam" alt="Podgląd kamery" src="{{ url_for('cam.snapshot') }}">
+  <p class="muted" id="cst"></p>
+</section>
+<script>
+const img = document.getElementById('cam'), st = document.getElementById('cst');
+const SNAP = '{{ url_for("cam.snapshot") }}', STREAM = '{{ url_for("cam.stream") }}', MAX = {{ max_s }};
+let live = false, timer;
+function start() {
+  clearTimeout(timer); live = true; img.src = STREAM + '?t=' + Date.now();
+  st.textContent = 'Na żywo. Podgląd zatrzyma się po zmianie karty lub po ' + Math.round(MAX / 60) + ' min.';
+  timer = setTimeout(stop, MAX * 1000);
+}
+function stop() { clearTimeout(timer); live = false; img.src = SNAP + '?t=' + Date.now(); st.textContent = 'Zatrzymano (widoczne zdjęcie).'; }
+document.getElementById('go').onclick = start;
+document.getElementById('stop').onclick = stop;
+document.getElementById('snap').onclick = stop;
+document.addEventListener('visibilitychange', () => { if (document.hidden && live) stop(); });
+img.onerror = () => { live = false; st.textContent = 'Kamera niedostępna lub zbyt wiele podglądów naraz.'; };
+</script>{% endblock %}
