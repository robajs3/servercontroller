SECRET_KEY=zmien_na_dlugi_losowy_ciag      # python -c "import secrets;print(secrets.token_hex(32))"
DB_PASSWORD=zmien_haslo_bazy
COOKIE_SECURE=1                            # 0 tylko do testów po http://localhost

# Serwer główny
MAIN_NAME=Serwer główny
MAIN_HOST=192.168.1.10
MAIN_MAC=AA:BB:CC:DD:EE:FF                 # etap 3 (WoL)
MAIN_TCP_PORT=22

# Interwały i retencja
PING_INTERVAL=10
FAIL_THRESHOLD=3                           # tyle nieudanych prób = OFFLINE
RETENTION_DAYS_RAW=2
RETENTION_DAYS_AGG=30

# --- Etap 3: WoL i wyłączanie ---
WOL_TOKEN=zmien_na_losowy_token            # python -c "import secrets;print(secrets.token_hex(24))"
WOL_BROADCAST=192.168.1.255                # broadcast Twojej podsieci (nie zostawiaj 255.255.255.255 przy wielu interfejsach)
MAIN_SSH_USER=panel
MAIN_SSH_PORT=22
BOOT_TIMEOUT=300                           # po tylu s bez odpowiedzi: "nie wstał"
SHUTDOWN_TIMEOUT=120

# --- Etap 4: agenci metryk ---
PANEL_TZ=Europe/Warsaw
METRICS_INTERVAL=15
AGENT_KEYS=main,local
AGENT_MAIN_NAME=Serwer główny
AGENT_MAIN_URL=http://192.168.1.10:8765    # lub https://main.TAILNET.ts.net:8765 (patrz agent/README.md)
AGENT_MAIN_TOKEN=token_z_install.sh
AGENT_MAIN_VERIFY=1
AGENT_LOCAL_NAME=Serwer dodatkowy
AGENT_LOCAL_URL=http://host.docker.internal:8765
AGENT_LOCAL_TOKEN=token_z_install.sh

# --- Etap 5: Docker ---
CONTAINER_POLL_INTERVAL=30
PROTECTED_PROJECTS=servercontroller        # kontenery tych projektów compose nie da się zatrzymać z panelu

# --- Etap 6: kamera (opcjonalna) ---
COMPOSE_PROFILES=camera                    # uruchamia kontener go2rtc; usuń, jeśli nie ma kamery
CAMERA_DEVICE=/dev/video0
CAMERA_URL=http://camera:1984              # puste = kamera wyłączona w panelu
CAMERA_SRC=cam
CAMERA_MAX_STREAMS=2
CAMERA_STREAM_MAX_SECONDS=900

# --- Ochrona logowania ---
LOGIN_MAX_FAILED=5                         # tyle błędnych prób = blokada konta
LOGIN_LOCK_MINUTES=10                      # na ile minut (odblokowanie ręczne: flask --app app unlock-user LOGIN)

# --- Content-Security-Policy ---
# CSP_REPORT_ONLY=1                        # tylko raportuje naruszenia w konsoli przeglądarki (do diagnozy), nie blokuje
